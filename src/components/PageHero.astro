---
interface Props {
  overline: string;
  title: string;
  deck: string;
  count: string;
}
const { overline, title, deck, count } = Astro.props;
---

<section class="page-hero reveal">
  <p class="page-overline">{overline}</p>
  <h1>{title}</h1>
  <div class="page-hero-foot"><p class="page-deck">{deck}</p><span class="page-count">{count}</span></div>
</section>
